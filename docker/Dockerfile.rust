# syntax=docker/dockerfile:1
#
# Runtime image for the Rust binding.
#
# Builds examples/rust/demo against the prebuilt shared library in /app/out,
# then ships only the compiled binary in the final image so the Rust toolchain
# (several hundred MB) is not part of the runtime image.
#
# The Rust toolchain is copied out of the official rust image instead of being
# installed with a shell script. Lockfile v4 (examples/rust/Cargo.lock) needs
# Cargo >= 1.78, and 1.98.1 matches the version used in this repository.
#
# Build the base image first (or use `make -C docker rust`):
#   docker build -f docker/Dockerfile.build -t jlw_example-build .
# Then:
#   docker build -f docker/Dockerfile.rust -t jlw_example-rust .
#   docker run --rm jlw_example-rust
#
# Override BUILD_IMAGE or RUST_IMAGE for a different image or registry path.

ARG BUILD_IMAGE=jlw_example-build:latest
ARG RUST_IMAGE=rust:1.98.1-bookworm

FROM ${RUST_IMAGE} AS rust

# Toolchain + prebuilt artifacts live here; this stage is discarded.
FROM ${BUILD_IMAGE} AS rustbuild

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

WORKDIR /app

RUN cargo build --manifest-path examples/rust/Cargo.toml

# Final image: the Julia-based build image without any Rust toolchain.
FROM ${BUILD_IMAGE}

COPY --from=rustbuild /app/examples/rust/target/debug/jlw-example-demo /usr/local/bin/jlw-example-demo

CMD ["jlw-example-demo"]
