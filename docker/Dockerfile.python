# syntax=docker/dockerfile:1
#
# Runtime image for the generated Python wrapper.
#
# Runs examples/python/demo.py against the prebuilt package in /app/out,
# using the in-repo PYTHONPATH route documented in README.md.
#
# Build the base image first:
#   docker build -f docker/Dockerfile.build -t jlw_example-build .
# Then:
#   docker build -f docker/Dockerfile.python -t jlw_example-python .
#   docker run --rm jlw_example-python
#
# Override BUILD_IMAGE to use a different build image or registry path:
#   docker build -f docker/Dockerfile.python \
#       --build-arg BUILD_IMAGE=registry.example.com/jlw_example-build:latest .

ARG BUILD_IMAGE=jlw_example-build:latest
FROM ${BUILD_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir numpy

ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /app

CMD ["sh", "-c", "PYTHONPATH=out python examples/python/demo.py"]
